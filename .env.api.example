# Copia este archivo a .env.api y complétalo. Nunca lo subas al repositorio (permisos 600 en el servidor).

# Base de datos: la misma que usa la app Next.js. La API crea lo que le falte (CREATE … IF NOT EXISTS) y nunca borra ni altera datos.
PGHOST=postgres
PGPORT=5432
PGDATABASE=bdpicocriollo
PGUSER=postgres
PGPASSWORD=CAMBIAR
# Conexiones máximas de la API a PostgreSQL (acuérdate del límite del servidor y de la app Next.js: ver DEPLOYMENT.md §3).
PGPOOL=10

# Clave de los tokens de sesión: al menos 32 caracteres al azar. Cambiarla cierra todas las sesiones.
#   openssl rand -base64 48
JWT_KEY=CAMBIAR

# Dirección pública de la APP WEB (con https, sin barra final): va en los correos de «olvidé mi contraseña» y autoriza a la web a llamar a la API.
APP_ORIGEN=https://app.ejemplo.co
# Dirección pública de la API (con https, sin barra final). Se incrusta en la app web al construirla: si cambia, hay que reconstruir.
API_URL_PUBLICA=https://api.ejemplo.co

# Correo saliente (opcional: sin esto, «olvidé mi contraseña» no envía correos).
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_DESDE=

# Avisos push (opcional): solo hace falta si activaste la seguridad reforzada de notificaciones en tu proyecto de Expo.
EXPO_ACCESS_TOKEN=

# Publica Swagger y /openapi/v1.json (documentan toda la API). Déjalo en false salvo que lo necesites.
OPENAPI_PUBLICAR=false
