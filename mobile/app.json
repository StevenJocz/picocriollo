{
  "expo": {
    "name": "Pico Criollo",
    "slug": "pico-criollo",
    "version": "1.0.0",
    "scheme": "picocriollo",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stereoface.picocriollo"
    },
    "android": {
      "package": "com.stereoface.picocriollo",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pico Criollo usa tus fotos para tu foto de perfil y tus publicaciones."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2c8c58"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f6faf8",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
