# Configuración de PostgreSQL para desarrollo local
PGHOST=localhost
PGPORT=5432
PGDATABASE=bdpicocriollo
PGUSER=postgres
PGPASSWORD=REEMPLAZA_CON_LA_CONTRASENA_DE_POSTGRES
DATABASE_SSL=false
APP_ORIGIN=http://localhost:3000

# Almacenamiento: file (desarrollo, archivo en .data/) o postgres (publicado). Sin definir: file en desarrollo, postgres en producción.
STORAGE_DRIVER=file
# STORAGE_FILE_PATH=.data/pico.json
# Secreto para POST /api/jobs/tick (cierre de subastas y recordatorios desde un cron)
# JOBS_SECRET=cambia-esto
